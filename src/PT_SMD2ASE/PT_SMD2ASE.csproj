<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows app (drag & drop GUI). Library sources are compiled in, so the net48 build is a single exe
       that runs on any Windows 10/11 PC without installing anything. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PT_RosettaStone</AssemblyName>
    <RootNamespace>PT_SMD2ASE</RootNamespace>
    <ApplicationIcon>PT_SMD2ASE.ico</ApplicationIcon>
    <Version>1.4.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>PristonTale - Rosetta Stone</Product>
    <Description>Converts Priston Tale game files (models, textures, sounds, text, model info) to readable formats</Description>
    <Copyright>Copyright (c) 2026 sungam3d - MIT License</Copyright>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Numerics" />
    <Reference Include="System.IO.Compression" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\PTSmd\*.cs" Link="PTSmd\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\smdanim\data\items.txt" LogicalName="PTSmd.data.items.txt" />
    <EmbeddedResource Include="..\..\smdanim\data\skills.txt" LogicalName="PTSmd.data.skills.txt" />
  </ItemGroup>
</Project>
